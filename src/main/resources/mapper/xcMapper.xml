<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!-- namespace 必须是 Mapper 接口的全限定名，一处不能错，否则绑定不上 -->
<mapper namespace="it.xcMapper">

    <!--
        id = 接口里的方法名（大小写严格一致）
        resultType = 返回的每行数据的类型
        注意：这里不要写 LIMIT，分页由 PageHelper 自动拼
    -->
    <select id="pageOrder" resultType="java.util.Map">
        SELECT id, number, status, user_id, amount, remark, create_time, update_time
        FROM orders
        <where>
            <!-- name 对应 pageDTO 里的属性名，不传就不加这个条件 -->
            <if test="name != null and name != ''">
                AND number LIKE concat('%', #{name}, '%')
            </if>
        </where>
        ORDER BY id DESC
    </select>

</mapper>
